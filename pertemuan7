print(("This is BMI Calculator"))
berat = float(input("Enter your weight: "))
tinggi = float(input("Enter your height: "))
def countBMI(berat, tinggi):
    BMI = berat/(tinggi**2)
    if BMI < 18.5:
        print("You are underweight")
    elif BMI < 25.0 and BMI > 18.5:
        print("You are normal")
    elif BMI < 29.9 and BMI > 25.0:
        print("Overweight")
    else:
        print("Obese")
countBMI(berat, tinggi)